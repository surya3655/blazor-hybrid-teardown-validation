@page "/module-loop"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<ModuleLoop> Logger

<PageTitle>Module Loop</PageTitle>

<article class="workbench">
    <p class="eyebrow">Scenario 01</p>
    <h1>Loaded module loop</h1>
    <p>A JavaScript module stays loaded and receives calls until this component is disposed.</p>
    <ScenarioStatus Label="Calls completed" Value="@_callCount.ToString()" />
    <p class="instruction">Navigate away while the indicator is active.</p>
</article>

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private IJSObjectReference? _module;
    private Task? _loopTask;
    private int _callCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/teardown.js");
        TeardownDiagnostics.TrackComponent(this);
        TeardownDiagnostics.TrackModule(_module);
        Logger.LogInformation("[Module] ModuleLoop acquired JS module reference.");

        _loopTask = RunLoopAsync(_disposeToken.Token);
    }

    private async Task RunLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                try
                {
                    if (_module is not null)
                    {
                        await _module.InvokeVoidAsync("recordModuleCall", cancellationToken, _callCount);
                        _callCount++;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (JSDisconnectedException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }

                await Task.Delay(100, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Error] ModuleLoop loop faulted.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        var stopwatch = Stopwatch.StartNew();
        var moduleWasLive = _module is not null;

        Logger.LogInformation(
            "[Dispose] ModuleLoop entered. Calls so far: {CallCount}. Module reference live: {ModuleWasLive}. WebView destroyed first: {WebViewGone}.",
            _callCount, moduleWasLive, TeardownDiagnostics.WebViewDestroyed);

        _disposeToken.Cancel();

        var loopStopped = true;

        if (_loopTask is not null)
        {
            try
            {
                // Bounded: a JS call that never returns must not hang teardown.
                await _loopTask.WaitAsync(TeardownDiagnostics.DisposeTimeout);
            }
            catch (TimeoutException)
            {
                loopStopped = false;
                Logger.LogWarning("[Dispose] ModuleLoop loop did not stop within the timeout.");
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[Error] ModuleLoop loop await faulted during disposal.");
            }
        }

        var moduleDisposed = false;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync().AsTask().WaitAsync(TeardownDiagnostics.DisposeTimeout);
                moduleDisposed = true;
            }
            catch (JSDisconnectedException)
            {
                // Expected once the WebView is gone. The framework fix means this
                // must not escape; catching it here keeps the app-side clean too.
            }
            catch (ObjectDisposedException)
            {
            }
            catch (TimeoutException)
            {
                Logger.LogWarning("[Dispose] ModuleLoop module disposal timed out.");
            }
        }

        _disposeToken.Dispose();
        stopwatch.Stop();

        Logger.LogInformation("[Cleanup] ModuleLoop completed after {CallCount} calls.", _callCount);
        Logger.LogInformation(
            "[Dispose] ModuleLoop returned after {ElapsedMs} ms. Loop stopped: {LoopStopped}. Module disposed cleanly: {ModuleDisposed}.",
            stopwatch.ElapsedMilliseconds, loopStopped, moduleDisposed);

        Debug.WriteLine($"[Cleanup] ModuleLoop completed after {_callCount} calls.");
    }
}
