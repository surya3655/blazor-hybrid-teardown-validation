@page "/timer"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<TimerStress> Logger

<PageTitle>Timer stress</PageTitle>

<article class="workbench">
    <p class="eyebrow">Scenario 03</p>
    <h1>Persistent timer</h1>
    <p>A periodic .NET timer invokes JavaScript and updates this component four times per second.</p>
    <ScenarioStatus Label="Timer ticks" Value="@_tickCount.ToString()" />
    <p class="instruction">Leave during rapid updates or rotate the device while this page is active.</p>
</article>

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private readonly PeriodicTimer _timer = new(TimeSpan.FromMilliseconds(250));
    private IJSObjectReference? _module;
    private Task? _timerTask;
    private int _tickCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/teardown.js");
        TeardownDiagnostics.TrackComponent(this);
        TeardownDiagnostics.TrackModule(_module);
        TeardownDiagnostics.TrackTimer(_timer);
        Logger.LogInformation("[Module] TimerStress acquired JS module reference.");

        _timerTask = RunTimerAsync(_disposeToken.Token);
    }

    private async Task RunTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    break;
                }

                try
                {
                    if (_module is not null)
                    {
                        await _module.InvokeVoidAsync("timerTick", cancellationToken, _tickCount);
                        _tickCount++;
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (JSDisconnectedException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Error] TimerStress timer loop faulted.");
        }
    }

    public async ValueTask DisposeAsync()
    {
        var stopwatch = Stopwatch.StartNew();

        Logger.LogInformation(
            "[Dispose] TimerStress entered. Ticks so far: {TickCount}. WebView destroyed first: {WebViewGone}.",
            _tickCount, TeardownDiagnostics.WebViewDestroyed);

        _disposeToken.Cancel();
        _timer.Dispose();

        var timerStopped = true;

        if (_timerTask is not null)
        {
            try
            {
                // Bounded: a JS call that never returns must not hang teardown.
                await _timerTask.WaitAsync(TeardownDiagnostics.DisposeTimeout);
            }
            catch (TimeoutException)
            {
                timerStopped = false;
                Logger.LogWarning("[Dispose] TimerStress timer task did not stop within the timeout.");
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[Error] TimerStress timer await faulted during disposal.");
            }
        }

        var moduleDisposed = false;

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync().AsTask().WaitAsync(TeardownDiagnostics.DisposeTimeout);
                moduleDisposed = true;
            }
            catch (JSDisconnectedException)
            {
            }
            catch (ObjectDisposedException)
            {
            }
            catch (TimeoutException)
            {
                Logger.LogWarning("[Dispose] TimerStress module disposal timed out.");
            }
        }

        _disposeToken.Dispose();
        stopwatch.Stop();

        Logger.LogInformation("[Cleanup] TimerStress completed after {TickCount} ticks.", _tickCount);
        Logger.LogInformation(
            "[Dispose] TimerStress returned after {ElapsedMs} ms. Timer stopped: {TimerStopped}. Module disposed cleanly: {ModuleDisposed}.",
            stopwatch.ElapsedMilliseconds, timerStopped, moduleDisposed);

        Debug.WriteLine($"[Cleanup] TimerStress completed after {_tickCount} ticks.");
    }
}
