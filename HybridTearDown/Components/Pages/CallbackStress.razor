@page "/callback"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<CallbackStress> Logger

<PageTitle>JavaScript callback</PageTitle>

<article class="workbench">
    <p class="eyebrow">Scenario 04</p>
    <h1>JavaScript-to-.NET callback</h1>
    <p>JavaScript holds a registered .NET object reference and calls it every 200 milliseconds.</p>
    <ScenarioStatus Label="Callbacks received" Value="@_callbackCount.ToString()" />
    <p class="instruction">Navigate away while callbacks are arriving.</p>
</article>

@code {
    private DotNetObjectReference<CallbackStress>? _dotNetReference;
    private IJSObjectReference? _module;
    private int _callbackHandle;
    private int _callbackCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/teardown.js");
        _dotNetReference = DotNetObjectReference.Create(this);
        _callbackHandle = await _module.InvokeAsync<int>("startCallbacks", _dotNetReference);
    }

    [JSInvokable]
    public async Task OnJavaScriptTick(int sequence)
    {
        _callbackCount = sequence;
        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException || ex is InvalidOperationException || ex.Message.Contains("disposed"))
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                try
                {
                    await _module.InvokeVoidAsync("stopCallbacks", _callbackHandle);
                }
                catch (JSDisconnectedException)
                {
                }
                catch (Exception ex) when (ex is ObjectDisposedException || ex.Message.Contains("disposed"))
                {
                }

                try
                {
                    await _module.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                }
                catch (Exception ex) when (ex is ObjectDisposedException || ex.Message.Contains("disposed"))
                {
                }
            }
        }
        finally
        {
            _dotNetReference?.Dispose();
        }

        Logger.LogInformation("[Cleanup] CallbackStress completed after {CallbackCount} callbacks.", _callbackCount);
        Debug.WriteLine($"[Cleanup] CallbackStress completed after {_callbackCount} callbacks.");
    }
}