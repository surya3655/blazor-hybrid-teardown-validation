<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Maui;assembly=Microsoft.AspNetCore.Components.WebView.Maui"
             xmlns:root="clr-namespace:HybridTearDown.Components"
             x:Class="HybridTearDown.MainPage"
             BackgroundColor="#F4F1E8">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,10" ColumnDefinitions="*,Auto,Auto" BackgroundColor="#173F5F">
            <Label Text="HYBRID TEARDOWN LAB"
                   TextColor="White"
                     FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Native screen"
                    Clicked="OnNativeScreenClicked"
                    AutomationId="NativeScreenButton" />
            <Button Grid.Column="2"
                Text="Close app"
                Clicked="OnCloseAppClicked"
                AutomationId="CloseAppButton" />

        </Grid>
        <blazor:BlazorWebView x:Name="BlazorHost" Grid.Row="1" HostPage="wwwroot/index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type root:Routes}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</ContentPage>